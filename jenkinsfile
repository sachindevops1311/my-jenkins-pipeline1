pipeline {
    agent any

    environment {
        DOCKER_HUB = credentials('dockerhub-credentials')
        IMAGE_NAME = 'sachindevops1311/jenkins-app'
        IMAGE_TAG = "${BUILD_NUMBER}"
        REGISTRY = 'docker.io'
    }

    stages {
        stage('📋 Checkout Code') {
            steps {
                echo '======== STAGE 1: CHECKOUT ========'
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/sachindevops1311/my-Jenkins-pipeline.git'
                    ]]
                ])
                sh 'echo "✅ Code checked out successfully"'
                sh 'ls -la'
            }
        }

        stage('🔨 Build Docker Image') {
            steps {
                echo '======== STAGE 2: BUILD ========'
                sh '''
                    echo "Building Docker image: ${IMAGE_NAME}:${IMAGE_TAG}"
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                    echo "✅ Docker image built successfully"
                    docker images | grep jenkins-app
                '''
            }
        }

        stage('🧪 Run Tests') {
            steps {
                echo '======== STAGE 3: TEST ========'
                sh '''
                    echo "Running unit tests..."
                    pip install -r requirements.txt
                    python -m pytest tests/test_app.py -v
                    echo "✅ All tests passed!"
                '''
            }
        }

        stage('🐳 Push to Docker Registry') {
            steps {
                echo '======== STAGE 4: PUSH ========'
                sh '''
                    echo "Logging into Docker Hub..."
                    echo "${DOCKER_HUB_PSW}" | docker login -u "${DOCKER_HUB_USR}" --password-stdin
                    
                    echo "Pushing image to registry..."
                    docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME}:latest
                    
                    echo "✅ Image pushed successfully"
                    docker logout
                '''
            }
        }

        stage('🚀 Deploy with Ansible') {
            steps {
                echo '======== STAGE 5: DEPLOY ========'
                sh '''
                    echo "Deploying application with Ansible..."
                    
                    # Install Ansible if needed
                    pip install ansible || true
                    
                    # Run playbook
                    ansible-playbook -i ansible/inventory.ini ansible/deploy.yml \
                        -e "docker_image=${IMAGE_NAME}:${IMAGE_TAG}" \
                        -v
                    
                    echo "✅ Deployment completed!"
                '''
            }
        }

        stage('✅ Verify Deployment') {
            steps {
                echo '======== STAGE 6: VERIFY ========'
                sh '''
                    echo "Verifying application..."
                    sleep 5
                    
                    # Check if container is running
                    docker ps | grep jenkins-app || echo "Container check skipped"
                    
                    # Health check
                    curl -s http://localhost:5000 | grep "Jenkins CI/CD" && \
                    echo "✅ Application is running!" || \
                    echo "⚠️ Application check skipped"
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline executed successfully!'
            echo "🎉 Application deployed: ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo '❌ Pipeline failed!'
        }
        always {
            echo "📊 Pipeline completed"
            cleanWs()
        }
    }
}